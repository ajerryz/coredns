$TTL 60
@   IN SOA ns1.example.com. admin.example.com. (
        2025010101 ; serial
        3600       ; refresh
        600        ; retry
        86400      ; expire
        60 )       ; minimum

@   IN NS  ns1.example.com.
@   IN NS  ns2.example.com.

ns1 IN A   127.0.0.1
ns2 IN A   127.0.0.1

www IN A   192.168.10.100
abc IN A   1.1.1.1
a   IN A   2.2.2.2
