$ORIGIN example.com.
@         IN  SOA   ns1.example.com. admin.example.com. (
                   2023010101  ; serial
                   7200         ; refresh
                   3600         ; retry
                   1209600      ; expire
                   3600         ; minimum
                   )
          IN  NS    ns1.example.com.
          IN  A     192.168.1.10   ; 主域名 A 记录

; 子域名 A 记录
www       IN  A     192.168.1.100
api       IN  A     192.168.1.101
app       IN  A     192.168.1.102